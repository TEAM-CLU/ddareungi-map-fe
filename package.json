{
  "name": "DdareungiMap",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "metro": "react-native start --reset-cache",
    "and:emu:only": "sh -c 'emulator -avd Pixel_6_API_35 -no-snapshot -gpu swiftshader_indirect -dns-server 8.8.8.8,1.1.1.1 & adb wait-for-device && until adb shell getprop sys.boot_completed | grep -m 1 1 >/dev/null; do sleep 1; done; react-native run-android --no-packager'",
    "and:device:only": "sh -c 'adb wait-for-device && until adb shell getprop sys.boot_completed | grep -m 1 1 >/dev/null; do sleep 1; done; react-native run-android --deviceId emulator-5554 --no-packager'",
    "ios:sim:only": "react-native run-ios --simulator 'iPhone 16 Pro' --verbose --no-packager",
    "ios:device:only": "react-native run-ios --device '😮‍💨👻🐣🥑' --verbose --no-packager",
    "dev:and:emu": "concurrently --raw --names \"watch,metro,android\" \"pnpm tw:watch\" \"pnpm metro\" \"pnpm and:emu:only\"",
    "dev:and:device": "concurrently --raw --names \"watch,metro,android\" \"pnpm tw:watch\" \"pnpm metro\" \"pnpm and:device:only\"",
    "dev:ios:sim": "concurrently --raw --names \"watch,metro,ios\" \"pnpm tw:watch\" \"pnpm metro\" \"pnpm ios:sim:only\"",
    "dev:ios:device": "concurrently --raw --names \"watch,metro,ios\" \"pnpm tw:watch\" \"pnpm metro\" \"pnpm ios:device:only\"",
    "clean:ios": "rm -rf node_modules yarn.lock package-lock.json pnpm-lock.yaml && pnpm install && cd ios && pod deintegrate && pod install --repo-update && cd ..",
    "clean:and": "rm -rf node_modules yarn.lock package-lock.json pnpm-lock.yaml && pnpm install && cd android && ./gradlew clean && cd ..",
    "clean:all": "pnpm run clean:ios && pnpm run clean:and",
    "start": "react-native start",
    "test": "jest",
    "tw:gen": "sh -c 'f=$(mktemp); npx tailwindcss -c tailwind.config.js -i ./tailwind.css -o \"$f\" && npx tailwind-rn --input \"$f\" --output ./styles.json; rm -f \"$f\"'",
    "tw:watch": "sh -c 'f=$(mktemp); trap \"rm -f \\\"$f\\\"\" EXIT; npx tailwindcss -c tailwind.config.js -i ./tailwind.css -o \"$f\" --watch | while read -r _; do npx tailwind-rn --input \"$f\" --output ./styles.json; done'",
    "link:ast": "npx react-native-asset"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/checkbox": "^0.5.20",
    "@react-native-community/datetimepicker": "^8.4.5",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-community/slider": "^5.1.1",
    "@react-native-picker/picker": "^2.11.2",
    "@react-native/new-app-screen": "0.81.0",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "@react-navigation/stack": "^7.4.8",
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.12.2",
    "classnames": "^2.5.1",
    "expo-av": "^16.0.7",
    "react": "19.1.0",
    "react-native": "0.81.1",
    "react-native-compass-heading": "^2.0.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-loading-spinner-overlay": "^3.0.1",
    "react-native-modal": "14.0.0-rc.1",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-pager-view": "^6.9.1",
    "react-native-paper": "^5.14.5",
    "react-native-paper-dropdown": "^2.3.1",
    "react-native-permissions": "^5.4.2",
    "react-native-picker-select": "^9.3.1",
    "react-native-reanimated": "^3.19.1",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.15.4",
    "react-native-sensors": "^7.3.6",
    "react-native-svg": "^15.13.0",
    "react-native-tts": "^4.1.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-volume-manager": "^2.0.8",
    "react-native-webview": "^13.16.0",
    "tailwind-rn": "^4.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.1",
    "@react-native/codegen": "^0.81.1",
    "@react-native/eslint-config": "0.81.1",
    "@react-native/gradle-plugin": "^0.81.1",
    "@react-native/metro-config": "0.81.1",
    "@react-native/typescript-config": "0.81.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.5",
    "@types/react-test-renderer": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "babel-plugin-module-resolver": "^5",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "metro": "^0.81.1",
    "metro-config": "^0.81.1",
    "metro-core": "0.81.1",
    "prettier": "2.8.8",
    "react-native-dotenv": "^3.4.11",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "3.4.13",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18"
  }
}
